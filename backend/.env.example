# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_learning_db
DB_USER=eduaccess_user
DB_PASSWORD=postgresql

# Server Configuration
PORT=5000

# Frontend origin(s) for CORS — comma-separated for multiple URLs, e.g.:
# FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Email verification (signup-only)
# This is used to sign the magic verification link.
SIGNUP_VERIFICATION_JWT_SECRET=your_email_verification_secret_change_in_production
SIGNUP_VERIFICATION_EXPIRY_MINUTES=30

# Publicly reachable backend base URL (used inside the email link)
EMAIL_VERIFICATION_BASE_URL=http://localhost:5000

# Email — password reset (use EMAIL_USER / EMAIL_PASS or SMTP_USER / SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# If SMTP times out (common on school Wi‑Fi), use Resend over HTTPS:
# RESEND_API_KEY=re_xxxxxxxxxxxx
